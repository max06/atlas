{{- /*
  Derived values: references keys defined by earlier entries in
  the values: list (inline map + plain .yaml) plus hierarchy baselines
  and .Release.*.
*/ -}}
hostFromInline: "{{ .appName }}.{{ .region }}.local"
hostFromPlain:  "{{ .appName }}.{{ .tier }}.{{ .zoneSuffix }}"
mixedHierarchyAndInline: "{{ .globalOnly }}-{{ .region }}"
mixedHierarchyAndPlain:  "{{ .clusterOnly }}-{{ .tier }}"
releaseAware:   "release-{{ .Release.Name }}-in-{{ .appName }}"
wrappedAccess:  "{{ .Values.region }}/{{ .Values.tier }}"
