# code: language=helm

{{/* Test entry point.

     Pre-wires the state-values that ATLAS expects so contributors (and
     CI) can run `helmfile <subcmd> -f tests/helmfile.yaml.gotmpl ...`
     without remembering the three --state-values-set flags every time:

         atlas.cwd                    repo root
         atlas.appTemplates           tests/templates
         atlas.deploymentDefinitions  tests/deployments

     Hands off to the real ATLAS entry point at the repo root, which
     applies env-var defaults (ATLAS_REDACT_SECRETS, ATLAS_FILTER_*),
     resolves variant, and dispatches to the per-cluster/per-deployment
     pipeline.

     atlas.cwd is computed via `git rev-parse --show-toplevel` so this
     entry works regardless of which subdirectory helmfile is invoked
     from. The other two paths are deliberately repo-relative — they
     describe where the test fixtures live, not where the user's pwd is. */}}

helmfiles:
  - path: ../helmfile.yaml.gotmpl
    values:
      - atlas:
          cwd: {{ exec "git" (list "rev-parse" "--show-toplevel") | trim }}
          appTemplates: tests/templates
          deploymentDefinitions: tests/deployments
