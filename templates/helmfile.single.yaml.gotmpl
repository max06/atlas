# code: language=helm

{{/*
============================================================
Atlas Deployment Renderer (stage 2 — fan-out only)
============================================================

Purpose:
  Resolves a single deployment into one sub-helmfile per app instance.
  All actual value resolution happens later, in helmfile.instance and
  the shared values-loader (atlas.values.merged), at helmfile's release-
  evaluation time where .Release.* is available.

Inputs (via env values from helmfile.all.yaml.gotmpl):
  .Values.atlas.cwd                         — absolute repo root
  .Values.atlas.appTemplates                — relative path to templates dir
  .Values.atlas.deploymentDefinitions       — relative path to deployments dir
  .Values.atlas.redactSecrets               — redaction toggle
  .Values.atlas.deployment.cluster          — full cluster path
  .Values.atlas.deployment.clusterName      — leaf cluster name
  .Values.atlas.deployment.clusterGroup     — present when cluster has a group
  .Values.atlas.deployment.deploymentName   — deployment dir name
  .Values.atlas.deployment.deploymentPath   — absolute deployment.yaml path

Output:
  A single `helmfiles:` list. Each entry points at helmfile.instance.yaml.gotmpl
  and carries the atlas object augmented with `instance.{template, name}`
  for that one app instance. Multi-instance deployments produce one
  sub-helmfile per instance — keeping atlas.instance unambiguous in
  per-file env values (multi-environments blocks in a single file
  collapse to a single merged env-values, so per-instance files are
  required).
*/}}

{{- /* Print a render-time breadcrumb so `helmfile build --debug` output is
     navigable when a deployment fails. */ -}}
# Rendering deployment:
#   cluster: {{ .Values.atlas.deployment.cluster }}
#   deploymentName: {{ .Values.atlas.deployment.deploymentName }}
{{ "" }}

{{- /* ====================== LOAD DEPLOYMENT DEFINITION ====================== */ -}}
{{- if not (isFile .Values.atlas.deployment.deploymentPath) }}
  {{- fail (printf "Deployment file not found: %s" .Values.atlas.deployment.deploymentPath) }}
{{- end }}

{{- /* Walk the hierarchy (global → group → cluster → deployment) once at
     fan-out time so deployment.yaml authors can use
     `{{ .Values.<hierarchyKey> }}` in apps[].name (or .template, or any
     other field that helmfile.single iterates here). Without this,
     template references resolve to empty strings, which silently
     malforms the per-instance fan-out (instance.name="" leaks through
     to helmfile.instance and breaks the auto-munge contract).

     .Release is a synthetic placeholder — helmfile's real .Release is
     only available later inside the values-loader. Hierarchy gotmpl
     files that reference .Release.* see empty values during this
     state-build pass; same caveat as helmfile.instance.yaml.gotmpl.

     skipSecrets: this pass never decrypts SOPS files — deployment.yaml
     structure (apps[].name etc.) must not derive from secrets. Secrets
     resolve only in the stage-3 values-loader. */ -}}
{{- $synthRelease := dict "Name" "" "Namespace" "" }}
{{- $hierarchy := include "atlas.hierarchy.merged" (dict
    "Values"      .Values
    "Release"     $synthRelease
    "redact"      false
    "skipSecrets" true
) | fromYaml }}
{{- $ctx := mergeOverwrite (deepCopy .Values) (deepCopy $hierarchy) }}
{{- $_ := set $ctx "Values" $ctx }}
{{- $_ := set $ctx "Release" $synthRelease }}
{{- $deploymentDefinition := tpl (readFile .Values.atlas.deployment.deploymentPath) $ctx | fromYaml }}

{{- /* ====================== INSTANCE FAN-OUT ====================== */ -}}
helmfiles:
{{- range $instance := $deploymentDefinition.apps }}
  {{- /* Resolve instance name (defaults to template name when not explicitly set). */ -}}
  {{- $instanceName := $instance.template }}
  {{- if hasKey $instance "name" }}
    {{- $instanceName = $instance.name }}
  {{- end }}
  {{- /* Build the atlas object passed to helmfile.instance — full hierarchy
       context plus the instance fields. deepCopy so each iteration gets its
       own atlas dict (set "instance" would otherwise leak across instances). */ -}}
  {{- $atlasForInstance := deepCopy $.Values.atlas }}
  {{- $_ := set $atlasForInstance "instance" (dict "template" $instance.template "name" $instanceName) }}
  - path: helmfile.instance.yaml.gotmpl
    values:
      - atlas:
          {{- $atlasForInstance | toYaml | nindent 10 }}
{{- end }}
