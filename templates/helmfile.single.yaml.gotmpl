# code: language=helm

{{/*
============================================================
Atlas Deployment Renderer (Cleaned & Refactored)
============================================================

Purpose:
  Renders a complete Helmfile snippet for ONE deployment.
  - Loads/merges values in priority order (global → group → cluster → deployment → component)
  - Supports SOPS-encrypted files (nested per-key decryption via fetchSecretValue)
  - Loads the deployment.yaml (as Go template) to know which components to instantiate from templates
  - For each deployment component:
    • Loads the corresponding app template (helmfile.yaml.gotmpl)
    • Applies instance-level overrides (nameSuffix, version, namespace, values, patches, labels…)
    • Injects all loadedValues + root .Values as final value layers
    • Outputs a clean Helmfile block
*/}}

{{- $debug := include "debugEnabled" . | trim | eq "true" }}

{{- /* ====================== BASE VARIABLES ====================== */ -}}
{{- $basePath := printf "%s/%s" .Values.atlas.cwd .Values.atlas.deploymentDefinitions }}
{{- $hasGroup := contains "/" .Values.atlas.deployment.cluster }}

{{- if $debug }}
# DEBUG: === ATLAS DEPLOYMENT RENDERER START ===
# DEBUG: basePath                  = {{ $basePath }}
# DEBUG: deployment.cluster        = {{ .Values.atlas.deployment.cluster }}
# DEBUG: hasGroup                  = {{ $hasGroup }}
# DEBUG: deployment.deploymentPath = {{ .Values.atlas.deployment.deploymentPath }}
{{- end }}

{{- /* ====================== VALUE SOURCE FILES (priority order) ====================== */ -}}
{{- $valueSources := list
  (dict "type" "secrets" "path" (printf "%s/global.values.sops.yaml" $basePath))
  (dict "type" "values" "path" (printf "%s/global.values.yaml"        $basePath))
  (dict "type" "templatedValues" "path" (printf "%s/global.values.yaml.gotmpl" $basePath))
}}

{{- if $hasGroup }}
  {{- $groupName := dir .Values.atlas.deployment.cluster }}
  {{- $valueSources = concat $valueSources (list
    (dict "type" "secrets" "path" (printf "%s/%s/group.values.sops.yaml"   $basePath $groupName))
    (dict "type" "values" "path" (printf "%s/%s/group.values.yaml"        $basePath $groupName))
    (dict "type" "templatedValues" "path" (printf "%s/%s/group.values.yaml.gotmpl" $basePath $groupName))
  )}}
{{- end }}

{{- $valueSources = concat $valueSources (list
  (dict "type" "secrets" "path" (printf "%s/%s/cluster.values.sops.yaml"   $basePath .Values.atlas.deployment.cluster))
  (dict "type" "values" "path" (printf "%s/%s/cluster.values.yaml"        $basePath .Values.atlas.deployment.cluster))
  (dict "type" "templatedValues" "path" (printf "%s/%s/cluster.values.yaml.gotmpl" $basePath .Values.atlas.deployment.cluster))
)}}

{{- $deploymentDir := dir .Values.atlas.deployment.deploymentPath }}
{{- $valueSources = concat $valueSources (list
  (dict "type" "secrets" "path" (printf "%s/values.sops.yaml"   $deploymentDir))
  (dict "type" "values" "path" (printf "%s/values.yaml"        $deploymentDir))
  (dict "type" "templatedValues" "path" (printf "%s/values.yaml.gotmpl" $deploymentDir))
)}}

{{- if $debug }}
# DEBUG: Value sources (later = higher priority):
{{- range $path := $valueSources }}
#   • {{ $path }}
{{- end }}
{{- end }}

{{- /* ====================== MERGE ALL VALUES (SOPS aware) ====================== */ -}}
{{- $loadedValues := dict "atlas" .Values.atlas }}

{{- range $source := $valueSources }}
  {{- if isFile $source.path }}
    # File found: {{ $source.path }}
    {{- if (eq $source.type "secrets") }}
      # File is a secret.
      {{- $encrypted := readFile $source.path | fromYaml }}

      {{- /* Decrypt the entire structure recursively */ -}}
      {{- $decrypted := include "atlas.decryptSopsNested" (dict
        "filePath" $source.path
        "data" $encrypted
        "keyPath" ""
      ) | fromJson -}}

      {{- $merged = mergeOverwrite $merged $decrypted -}}




    {{- else }}
      {{- $rendered := tpl (readFile $source) $loadedValues }}
      {{- $parsed   := fromYaml $rendered }}
      {{- $loadedValues = mergeOverwrite $loadedValues $parsed }}
    {{- end }}
  {{- end }}
{{- end }}

environments:
  default:
    values:
      - {{ $loadedValues | toYaml | nindent 8 }}
{{ "---" | nindent 0 }}
