# code: language=helm

# This template discovers all clusters and deployments in a hierarchical directory structure,
# assigns deployments to clusters based on global, group, and cluster-specific levels,
# and generates a flat list of helmfile entries for each cluster-deployment pair.
#
# DIRECTORY STRUCTURE OVERVIEW:
#   deployments/
#     apps/                           <- Global deployments (applied to all clusters)
#       global-app/
#         deployment.yaml
#
#     single-cluster/                 <- Standalone cluster (no group)
#       apps/
#         single-app/
#           deployment.yaml
#
#     group-name/                     <- Cluster group
#       apps/                         <- Group-level deployments (applied to all clusters in group)
#         group-app/
#           deployment.yaml
#
#       cluster-a/                    <- Individual cluster in group
#         apps/
#           cluster-app/
#             deployment.yaml
#
#       cluster-b/                    <- Another cluster in same group
#         apps/
#           another-app/
#             deployment.yaml
#
# DEPLOYMENT ASSIGNMENT RULES:
# 1. Global deployments (deployments/apps/*) are assigned to ALL clusters.
# 2. Group deployments (deployments/GROUP/apps/*) are assigned to all clusters within that GROUP.
# 3. Cluster deployments (deployments/[GROUP/]CLUSTER/apps/*) are assigned only to that specific
#    CLUSTER.
#
# OUTPUT FORMAT:
# A YAML list under 'helmfiles:' where each item represents a deployment assignment to a cluster,
# with:
# - cluster: Full cluster path like "group-name/cluster-a" or "single-cluster".
#   Used for filesystem lookups (cluster values files live under this path).
# - clusterName: Leaf cluster name only ("cluster-a", "single-cluster"). Used for
#   naming downstream resources (e.g. ArgoCD Application names) where the
#   group-prefixed path would contain an illegal "/". Leaf names must be unique
#   across the repo for this to be unambiguous.
# - clusterGroup: Group prefix of the cluster path ("group-name" for
#   "group-name/cluster-a"). OMITTED for standalone clusters, so templates
#   can gate group-scoped features by testing whether the key is present.
# - deploymentName: The name of the deployment (derived from its directory).
# - path: Absolute path to the deployment.yaml file.
#
# This output configures helmfile entries that point to a single deployment renderer template
# (helmfile.single.yaml.gotmpl), injecting the necessary context for each deployment.

{{- if not (and (isAbs $.Values.atlas.cwd) (isDir $.Values.atlas.cwd)) }}
  {{- fail "No valid cwd given" }}
{{- end }}
{{- $repoRoot := $.Values.atlas.cwd }}
{{- $deploymentsDir := printf "%s/%s" $repoRoot $.Values.atlas.deploymentDefinitions }}

# STEP 1: DISCOVER ALL CLUSTERS
# Identify all directories with an "apps" subdirectory. Only leaf clusters
# (no child "apps" directories) are collected as deployment targets.
{{- $clustersPattern := printf "%s/**/apps" $deploymentsDir }}
{{- $clustersRaw := include "glob" $clustersPattern | fromJson }}

{{- $clusters := dict }}

{{- range $clustersRaw }}
  {{- $clusterPath := . | trimPrefix (printf "%s/" $deploymentsDir) | dir }}

  {{- if ne $clusterPath "" }}
    {{- $childPattern := printf "%s/%s/*/apps" $deploymentsDir $clusterPath }}
    {{- $hasChildren := include "glob" $childPattern | fromJson }}
    {{- $isLeaf := eq (len $hasChildren) 0 }}
    {{- if $isLeaf }}
      {{- $_ := set $clusters $clusterPath (list) }}
    {{- end }}
  {{- end }}
{{- end }}

# STEP 2: COLLECT DEPLOYMENTS FOR EACH CLUSTER
# For each leaf cluster, gather deployments from:
# 1. Global level (applied to all).
# 2. Group level (if in a group).
# 3. Cluster-specific level.

{{- range $cluster := keys $clusters | sortAlpha }}
  {{- $collectedDeployments := list }}
  {{- $collectedDeploymentsRaw := list }}

  {{- $globalPattern := printf "%s/apps/*/deployment.yaml" $deploymentsDir }}
  {{- $globalDeployments := include "glob" $globalPattern | fromJson }}
  {{- $collectedDeploymentsRaw = concat $collectedDeploymentsRaw $globalDeployments }}

  {{- $groupPath := $cluster | dir }}
  {{- if ne $groupPath "." }}
    {{- $groupPattern := printf "%s/%s/apps/*/deployment.yaml" $deploymentsDir $groupPath }}
    {{- $groupDeployments := include "glob" $groupPattern | fromJson }}
    {{- $collectedDeploymentsRaw = concat $collectedDeploymentsRaw $groupDeployments }}
  {{- end }}

  {{- $clusterPattern := printf "%s/%s/apps/*/deployment.yaml" $deploymentsDir $cluster }}
  {{- $clusterDeployments := include "glob" $clusterPattern | fromJson }}
  {{- $collectedDeploymentsRaw = concat $collectedDeploymentsRaw $clusterDeployments }}

  {{- range $collectedDeploymentsRaw }}
    {{- $deployment := dict "deploymentName" (. | dir | base) "path" . }}
    {{- $collectedDeployments = append $collectedDeployments $deployment }}
  {{- end }}

  {{- $_ := set $clusters $cluster $collectedDeployments -}}
{{- end }}

# All recognized deployments
{{- range (toYaml $clusters | splitList "\n") }}
  # {{ . }}
{{- end }}

# OUTPUT
# Generate YAML helmfiles list, each pointing to the single deployment renderer,
# with injected atlas context and specific deployment details. atlas.filter.deploymentName
# narrows the list further without affecting unmatched clusters already dropped
# in STEP 1.
#
# The filter key itself is stripped before being passed to sub-helmfiles — it's
# an instruction to stage 1 only and has no meaning inside a rendered release.
# Leaving it in would leak the filter values through .Values.atlas into every
# chart, silently corrupting renders whose output should be identical with or
# without the filter applied.
#
# Each sub-helmfile entry carries a `selectors:` spec (helmfile/helmfile#2545)
# so --selector can drop non-matching sub-helmfiles BEFORE they're parsed and
# their SOPS values decrypted. The spec is a single comma-separated string of
# k=v pairs (AND within a spec; list of specs = OR across specs). Labels
# mirror the commonLabels block in helmfile.single.yaml.gotmpl so a CLI
# selector matches identically at both the sub-helmfile and release levels.
# The stage-1 atlas.filter.* path stays in place for helmfile versions without
# selector-aware sub-helmfile filtering.
{{- $atlasForSub := omit .Values.atlas "filter" }}
helmfiles:
{{- range $cluster, $deployments := $clusters }}
  {{- $clusterName := $cluster | base }}
  {{- /* clusterGroup: non-empty only when the cluster path contains a slash.
       `dir` on a slash-less string returns ".", so we key off contains to
       decide whether the field is meaningful. */ -}}
  {{- $clusterGroup := "" }}
  {{- if contains "/" $cluster }}
    {{- $clusterGroup = $cluster | dir }}
  {{- end }}
  {{- range $deployment := $deployments }}
  - path: helmfile.single.yaml.gotmpl
    selectors:
      - cluster={{ $cluster }},clusterName={{ $clusterName }}{{ if $clusterGroup }},clusterGroup={{ $clusterGroup }}{{ end }},deploymentName={{ $deployment.deploymentName }},variant={{ $atlasForSub.variant }}
    values:
      - atlas:
          {{- $.Values.atlas | toYaml | nindent 10 }}
          deployment:
            cluster: {{ $cluster }}
            clusterName: {{ $clusterName }}
            {{- if $clusterGroup }}
            clusterGroup: {{ $clusterGroup }}
            {{- end }}
            deploymentName: {{ $deployment.deploymentName }}
            deploymentPath: {{ $deployment.path }}
  {{- end }}
{{- end }}
